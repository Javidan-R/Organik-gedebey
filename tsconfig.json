{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],

    // ── Performans üçün ciddi yoxlamaları səhv bildirişə çevirək ─────
    "noUnusedLocals": false,           // ❌ vaxt aparan əsas səbəb
    "noUnusedParameters": false,       // ❌ əlavə yüklənmə
    "noImplicitReturns": false,        // ❌ funksiya daxilində yoxlama
    "noFallthroughCasesInSwitch": true, // ✅ işlək qala bilər
    "noUncheckedIndexedAccess": false,  // ❌ hər massiv/obyekt girişində yoxlama
    "noImplicitOverride": false,
    "noPropertyAccessFromIndexSignature": false,
    "forceConsistentCasingInFileNames": true,

    // Əlavə performans
    "skipDefaultLibCheck": true,
    "useDefineForClassFields": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "dist",
    "build"
  ]
}